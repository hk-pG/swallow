# Swallow — 環境変数の雛形（秘密の値は入れない）
#
# 使い方:
#   cp .env.example .env
# 実際のトークンやパスは `.env` にだけ書き、コミットしない。
# 各変数の対応関係と必須／任意は README の「Environment variables」と docs/HANDOFF.md を参照。

# -----------------------------------------------------------------------------
# Cursor Cloud Agent（Orca worktree から cloud-run.sh を叩くとき）
# -----------------------------------------------------------------------------

# Cursor Dashboard → API Keys で発行。cloud-run.sh が Cloud Agents API の Basic 認証に使う。
# 必須（--dry-run 以外）。例: cur_xxxxxxxx（実際のキーに置き換える）
# CURSOR_API_KEY=

# このリポ向け fine-grained PAT（Issue／PR／ラベル等）。任意。
# ホスト側の名前。cloud-run.sh が Cloud Agent 起動時に GH_TOKEN へ渡す。
# 未設定でも PR 作成は Cursor 組み込みで行えることが多い。Issue への gh 書き込みには GH_TOKEN が必要。
# SWALLOW_CLOUD_GH_TOKEN=

# Cloud Agent 内で gh / 一部スクリプトが読む GitHub トークン。
# 推奨: Cursor Dashboard の Runtime Secret 名は GH_TOKEN（正本）。
# Orca から起動するときだけ、上の SWALLOW_CLOUD_GH_TOKEN がここにマップされる。
# ローカルで gh auth login 済みなら通常は不要（gh が別経路で認証）。
# GH_TOKEN=

# -----------------------------------------------------------------------------
# scripts/agent（ローカル開発・エージェント補助）
# -----------------------------------------------------------------------------

# start-issue.sh --worktree の親ディレクトリ。未設定時は ../<リポ名>-worktrees
# SWALLOW_WORKTREE_DIR=

# github-taxonomy-setup.sh の対象リポ。未設定時は hk-pG/swallow
# REPO=hk-pG/swallow

# -----------------------------------------------------------------------------
# コンテナ・Rust ツールチェーン（通常は触らない）
# -----------------------------------------------------------------------------
# docker/build.Dockerfile と Dev Container が設定。PATH 補正は scripts/agent/lib.sh。
# CARGO_HOME=/usr/local/cargo
# RUSTUP_HOME=/usr/local/rustup

# -----------------------------------------------------------------------------
# Tauri / Vite（pnpm dev や tauri build が自動設定。手動 .env はほぼ不要）
# -----------------------------------------------------------------------------
# TAURI_DEV_HOST=
# TAURI_ENV_DEBUG=
# TAURI_ENV_PLATFORM=
