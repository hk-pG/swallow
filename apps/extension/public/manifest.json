{
  "manifest_version": 3,
  "name": "Swallow",
  "version": "0.1.0",
  "description": "Web ページの画像を Swallow に保存します。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["scripting", "notifications", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:41600/*", "https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Swallow に保存",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
