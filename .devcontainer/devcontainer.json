{
  "name": "torpedo",
  "build": {
    "dockerfile": "../docker/build.Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "remoteUser": "builder",
  "mounts": [
    "source=torpedo-node_modules,target=/workspace/node_modules,type=volume",
    "source=torpedo-desktop_node_modules,target=/workspace/apps/desktop/node_modules,type=volume",
    "source=torpedo-shared_node_modules,target=/workspace/packages/shared/node_modules,type=volume",
    "source=torpedo-target,target=/workspace/target,type=volume",
    "source=torpedo-cargo_registry,target=/usr/local/cargo/registry,type=volume",
    "source=torpedo-pnpm_store,target=/pnpm-store,type=volume"
  ],
  "postCreateCommand": "sudo chown builder /workspace/node_modules /workspace/apps/desktop/node_modules /workspace/packages/shared/node_modules /workspace/target /usr/local/cargo/registry /pnpm-store && pnpm install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "biomejs.biome", "tauri-apps.tauri-vscode"]
    }
  }
}
